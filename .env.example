# Copy to .env and fill. .env is git-ignored.

# Shared secret between the MCP server and the internal Jupyter Server.
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
JUPYTER_TOKEN=changeme-jupyter-token

# App-level bearer token. SET THIS unless something in front of the server already
# authenticates callers — this server executes arbitrary code, so an unauthenticated
# reachable endpoint is a remote shell. Generate the same way as JUPYTER_TOKEN.
# Leave it EMPTY only when: (a) you never expose the port beyond 127.0.0.1, or
# (b) your proxy uses an OAuth flow that sets its own Authorization header, which
# would collide with this bearer and make FastMCP return 401. See docs/AUTH.md.
MCP_BEARER=

# Host loopback port the MCP server listens on (127.0.0.1 only — put your proxy
# or tunnel in front of it if you need remote access).
MCP_HOST_PORT=7130

# Kernel session policy
KERNEL_IDLE_TIMEOUT_SEC=3600      # reap kernels idle longer than this (0 = never)
KERNEL_MAX_AGE_SEC=28800          # absolute hard cap: reap at this age regardless
                                  # of activity (Colab-style). 0 = disabled.
EXEC_TIMEOUT_SEC=120              # default per-execution timeout
MAX_KERNELS=8                     # cap concurrent kernels

# Colab-only mode: refuse to EXECUTE code on the local backend — every kernel runs
# on a Colab VM under your own Google account. The local Jupyter still stores and
# serves the notebooks (editing, listing, workspace files all keep working); it just
# never runs user code. Requires working GCLOUD_ADC creds — the server refuses to
# start without them. Leave empty for the normal local+colab deployment.
# COLAB_ONLY=1

# Path to Google ADC creds for colab-cli GPU offload. Create with
# `gcloud auth application-default login`, then point this at the resulting file
# (typically ~/.config/gcloud/application_default_credentials.json).
# GCLOUD_ADC=/absolute/path/to/application_default_credentials.json

# Kaggle API (server-side only; injected into the jupyter container so notebooks
# can `!kaggle datasets download ...`). CURRENT method = a single token:
#   kaggle.com/settings/api -> "Generate New Token" (API section)
# KAGGLE_API_TOKEN=your_kaggle_api_token
# Legacy fallback (kaggle.com -> "Create Legacy API Key" -> kaggle.json):
# KAGGLE_USERNAME=your_kaggle_username
# KAGGLE_KEY=your_kaggle_api_key

# Loopback port for human JupyterLab (127.0.0.1 only) — open it in a browser to
# watch/edit the same notebooks Claude is working in.
JUPYTER_LAB_HOST_PORT=7131

# Uid/gid the mcp container runs as; must be able to read GCLOUD_ADC (mode 600).
# Only needed if your account is not 1000:1000 — check with `id -u` / `id -g`.
# MCP_UID=1000
# MCP_GID=1000
